  WiFi.begin(ssid, password);
  int progress = 0;
  while (WiFi.status() != WL_CONNECTED && progress < 84) {
    tft.fillRect(20, 92, progress, 4, COLOR_ACCENT_CYAN);
    delay(100);
    progress += 3;
  }
  
  configTime(gmtOffset_sec, daylightOffset_sec, ntpServer1, ntpServer2);

  descarcaDateMeteo();
  temp_afisata = temp_curenta; 
