  tft.fillRoundRect(x + 3, y + 3, w, h, 8, 0x0000);
  tft.drawRoundRect(x + 2, y + 2, w, h, 8, 0x0802);
  tft.fillRoundRect(x, y, w, h, 8, COLOR_GLASS_CARD);
  tft.drawFastHLine(x + 5, y, w - 10, COLOR_GLASS_HIGH);
  tft.drawFastHLine(x + 5, y + 1, w - 10, COLOR_GLASS_HIGH);
  tft.drawFastHLine(x + 5, y + h - 1, w - 10, COLOR_GLASS_LOW);
  tft.drawRoundRect(x, y, w, h, 8, COLOR_ACCENT_CYAN);
}

void playQuantumTransition() {
  in_tranzitie = true;
  for (int h = 0; h <= 80; h += 8) {
    tft.fillRect(0, 80 - h, 128, h * 2, COLOR_BG);
    tft.drawFastHLine(0, 80 - h, 128, COLOR_ACCENT_CYAN);
    tft.drawFastHLine(0, 80 + h, 128, COLOR_ACCENT_BLUE);
    delay(4);
  }
  
  pagina_curenta = pagina_urmatoare;
  tft.fillScreen(COLOR_BG);
  drawStatusBar();
  drawPageDots();
  renderCurrentPageContent();
  
  for (int h = 80; h >= 0; h -= 8) {
    tft.drawFastHLine(0, 80 - h, 128, COLOR_ACCENT_CYAN);
    tft.drawFastHLine(0, 80 + h, 128, COLOR_ACCENT_BLUE);
    delay(3);
    tft.drawFastHLine(0, 80 - h, 128, COLOR_BG);
    tft.drawFastHLine(0, 80 + h, 128, COLOR_BG);
  }
  in_tranzitie = false;
  necesita_redesenare = true;
}

