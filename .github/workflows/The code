// ======================== ANIMATIONS & REFRESH ========================

uint16_t getThermalColor(int val) {
  if (val > 85) return 0xFFFF;      
  if (val > 70) return 0xF800;      
  if (val > 50) return 0xFD20;      
  if (val > 35) return 0xFFE0;      
  if (val > 20) return 0x07E0;      
  return 0x001F;                    
}

void updateAnimations() {
  unsigned long ms_curent = millis();

  if (ms_curent - timer_ceas_sec > 1000) {
    timer_ceas_sec = ms_curent;
    if (!in_tranzitie) {
      struct tm timeinfo;
      if(getLocalTime(&timeinfo)){
        char timeBuffer[6];
        strftime(timeBuffer, sizeof(timeBuffer), "%H:%M", &timeinfo);
        tft.fillRect(68, 2, 40, 12, COLOR_BG);
        tft.setTextSize(1);
        tft.setTextColor(COLOR_TEXT_MAIN);
        tft.setCursor(68, 4);
        tft.print(timeBuffer);

        if (pagina_curenta == 5) {
          tft.fillRect(16, 108, 96, 20, COLOR_GLASS_CARD);
          char oraBuf[10];
          snprintf(oraBuf, sizeof(oraBuf), "%02d:%02d:%02d", timeinfo.tm_hour, timeinfo.tm_min, timeinfo.tm_sec);
          drawCenteredText(String(oraBuf), 108, 2, COLOR_HOT);
        }
      }
    }
  }

  if (ms_curent - timer_numeric_tween > INTERVAL_TWEEN) {
    timer_numeric_tween = ms_curent;
    if (abs(temp_curenta - temp_afisata) > 0.05) {
      temp_afisata += (temp_curenta > temp_afisata) ? 0.1 : -0.1;
      if (pagina_curenta == 0 && !in_tranzitie) {
        tft.fillRect(16, 45, 96, 20, COLOR_GLASS_CARD);
        String valTemp = String(temp_afisata, 1) + " C";
        drawCenteredText(valTemp, 45, 2, COLOR_TEXT_MAIN);
      }
    }
  }

  if (ms_curent - timer_animatii > INTERVAL_ANIMATIE) {
    timer_animatii = ms_curent;

    if (pagina_curenta == 2 && !in_tranzitie) {
      static float anim_time = 0;
      float fluid_speed = 0.12 + (viteza_vant * 0.015);
      anim_time += fluid_speed;
      
      float wind_rad = directie_vant * (PI / 180.0);
      float vx = cos(wind_rad);
      float vy = sin(wind_rad);

      int start_x = 16;
      int start_y = 44;
      int base_heat = map((int)temp_curenta, -10, 40, 15, 55);

      for(int y = 0; y < 11; y++) {
        for(int x = 0; x < 15; x++) {
           int zone = mioveni_grid[y][x];
           int heat = base_heat; 
           
           if(zone == 0) heat -= 12;      
           else if(zone == 1) heat += 4;  
           else if(zone == 2) heat += 18; 
           else if(zone == 3) heat += 40; 
           
           float wave = (x * vx) + (y * vy);
           int noise = sin(wave * 0.7 + anim_time) * 14; 
           heat += noise;
           heat = constrain(heat, 0, 100);
           
           tft.fillRect(start_x + (x * 6), start_y + (y * 6), 6, 6, getThermalColor(heat));
        }
      }
      
      tft.drawRect(start_x - 2, start_y - 2, (15 * 6) + 4, (11 * 6) + 4, COLOR_GLASS_LOW);
      tft.drawFastHLine(start_x, start_y + 33, 90, COLOR_ACCENT_CYAN); 
    }
  }
}

// ======================== API WEATHER & NTP ===========================

void descarcaDateMeteo() {
  if (WiFi.status() != WL_CONNECTED) return;
  
  tft.fillCircle(115, 8, 3, COLOR_HOT); 
  
  WiFiClientSecure *client = new WiFiClientSecure;
  client->setInsecure(); 
  HTTPClient http;
  
  String url = "https://api.open-meteo.com/v1/forecast?latitude=44.85&longitude=24.88&current=temperature_2m,apparent_temperature,relative_humidity_2m,surface_pressure,windspeed_10m,winddirection_10m,uv_index,visibility&forecast_days=1";
  
  if (http.begin(*client, url)) {
    int codRaspuns = http.GET();
    if (codRaspuns == 200) {
      String payload = http.getString();
      bytes_transferati = payload.length();
      
      DynamicJsonDocument doc(12288);
      if (!deserializeJson(doc, payload)) {
        temp_curenta = doc["current"]["temperature_2m"].as<float>();
        temp_resimtita = doc["current"]["apparent_temperature"].as<float>();
        umiditate = doc["current"]["relative_humidity_2m"].as<float>();
        presiune_atmosferica = doc["current"]["surface_pressure"].as<float>();
        viteza_vant = doc["current"]["windspeed_10m"].as<float>();
        directie_vant = doc["current"]["winddirection_10m"].as<int>();
        index_uv = doc["current"]["uv_index"].as<float>();
        vizibilitate = (doc["current"]["visibility"].as<float>()) / 1000.0;
        
        date_descarcate = true;
        necesita_redesenare = true;
      }
    }
    http.end();
  }
  delete client;
  tft.fillCircle(115, 8, 3, COLOR_ACCENT_CYAN);
}

