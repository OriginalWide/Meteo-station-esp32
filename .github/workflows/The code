void drawCenteredText(String text, int y, uint8_t size, uint16_t color, int centerX = 64) {
  int textWidth = text.length() * 6 * size;
  int startX = centerX - (textWidth / 2);
  if (startX < 2) startX = 2;
  tft.setTextSize(size);
  tft.setTextColor(color);
  tft.setCursor(startX, y);
  tft.print(text);
}

