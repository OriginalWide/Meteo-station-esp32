void drawStatusBar() {
  tft.fillRect(0, 0, 128, 16, COLOR_BG); 
  tft.setTextSize(1);
  tft.setTextColor(COLOR_ACCENT_CYAN);
  tft.setCursor(4, 4);
  tft.print("MIOVENI OS");

  struct tm timeinfo;
  if(getLocalTime(&timeinfo)){
    char timeBuffer[6];
    strftime(timeBuffer, sizeof(timeBuffer), "%H:%M", &timeinfo);
    tft.setTextColor(COLOR_TEXT_MAIN);
    tft.setCursor(68, 4);
    tft.print(timeBuffer);
  }

  rssi_wifi = WiFi.RSSI();
  int calitate = (rssi_wifi > -50) ? 4 : (rssi_wifi > -70) ? 3 : (rssi_wifi > -85) ? 2 : 1;
  int x_start = 114;
  for (int i = 0; i < 4; i++) {
    uint16_t color = (i < calitate) ? COLOR_TEXT_MAIN : COLOR_GLASS_CARD;
    int h = (i + 1) * 3;
    tft.drawFastVLine(x_start + (i * 3), 12 - h, h, color);
    tft.drawFastVLine(x_start + (i * 3) + 1, 12 - h, h, color);
  }
}

void drawPageDots() {
  int x_center = 64;
  int space = 8; 
  int start_x = x_center - ((NUMAR_PAGINI - 1) * space) / 2;
  tft.fillRect(0, 148, 128, 12, COLOR_BG); 
  for (int i = 0; i < NUMAR_PAGINI; i++) {
    if (i == pagina_curenta) {
      tft.fillRoundRect(start_x + (i * space) - 4, 151, 8, 3, 1, COLOR_ACCENT_CYAN);
    } else {
      tft.fillCircle(start_x + (i * space), 152, 1, COLOR_TEXT_MUTED);
    }
  }
}

