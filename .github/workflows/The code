}

void loop() {
  t_start_loop = micros(); 
  unsigned long ms_curent = millis();

  if (!in_tranzitie) {
    bool citire_next = digitalRead(BTN_NEXT);
    if (citire_next == LOW && stare_next_ant == HIGH && (ms_curent - debounce_btn > 220)) {
      pagina_urmatoare = (pagina_curenta + 1) % NUMAR_PAGINI;
      playQuantumTransition();
      debounce_btn = ms_curent;
    }
    stare_next_ant = citire_next;

    bool citire_prev = digitalRead(BTN_PREV);
    if (citire_prev == LOW && stare_prev_ant == HIGH && (ms_curent - debounce_btn > 220)) {
      pagina_urmatoare = (pagina_curenta - 1 + NUMAR_PAGINI) % NUMAR_PAGINI;
      playQuantumTransition();
      debounce_btn = ms_curent;
    }
    stare_prev_ant = citire_prev;
  }

  if (necesita_redesenare && !in_tranzitie) {
    tft.fillScreen(COLOR_BG);
    drawStatusBar();
    drawPageDots();
    renderCurrentPageContent();
    necesita_redesenare = false;
  }

  updateAnimations();

  if (ms_curent - timer_meteo > INTERVAL_METEO) {
    descarcaDateMeteo();
    timer_meteo = ms_curent;
  }

  timp_executie_ciclu = micros() - t_start_loop;
}

